# ================================================
# CP BerryTech — WhatsApp Agent
# Copia este archivo a .env y rellena los valores
# ================================================

# API Key de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Token de acceso de Meta WhatsApp Business API
# Se obtiene en: developers.facebook.com → tu app → WhatsApp → Configuración de API
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx

# Token que TÚ eliges para verificar el webhook (cualquier string aleatorio)
VERIFY_TOKEN=cpberrytech_webhook_2024

# ID del número de teléfono de WhatsApp Business
# En Meta Developers → WhatsApp → Configuración de API → Phone Number ID
PHONE_NUMBER_ID=1234567890

# Número de WhatsApp del administrador para recibir alertas de leads
# Formato internacional sin + (ej: 523349834257 para México +52 334 983 4257)
ADMIN_PHONE=523349834257

# Puerto del servidor (Railway/Render asignan PORT automáticamente)
PORT=3000
